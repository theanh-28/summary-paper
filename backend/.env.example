# =============================================================================
# Backend Environment Variables — Example
# =============================================================================
# Copy this file to .env.docker (for Docker) or .env.dev (for local dev)
# and update the values as needed.

# --- Database ---
DB_HOST=db
DB_PORT=3306
DB_NAME=summary_paper
DB_USER=summary_user
DB_PASSWORD=summary_pass

# --- JWT Authentication ---
SECRET_KEY=dev-secret-key-change-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Debug Mode ---
DEBUG=true

# --- CORS (comma-separated list of allowed origins) ---
CORS_ORIGINS=http://localhost:5173

# --- Metabase Embedding ---
# URL phải là browser-facing (trình duyệt user truy cập được)
METABASE_SITE_URL=http://localhost:3000
# Khóa bí mật để ký JWT embed — PHẢI khớp với MB_EMBEDDING_SECRET_KEY trong docker-compose
METABASE_SECRET_KEY=my-super-secret-metabase-embedding-key-32chars
# Dashboard IDs trong Metabase (được tạo tự động bởi metabase-setup container)
METABASE_ADMIN_DASHBOARD_ID=1
METABASE_USER_DASHBOARD_ID=2
